<Window x:Class="KytyLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KytyLauncher"
        Title="KytyPS5 Launcher" Width="1440" Height="880" MinWidth="1120" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBrush}"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextBrush}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        Icon="pack://application:,,,/Assets/kytyps5.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- The About icon drawn as vectors: a circle with an "i", symmetric to the pixel (the font glyph is not) -->
        <DrawingImage x:Key="InfoIcon">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z"/>
                    <GeometryDrawing>
                        <GeometryDrawing.Pen>
                            <Pen Brush="White" Thickness="1.6"/>
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="12,12" RadiusX="8.4" RadiusY="8.4"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="White">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <EllipseGeometry Center="12,8.1" RadiusX="1.1" RadiusY="1.1"/>
                                <RectangleGeometry Rect="11.2,10.3,1.6,6.2" RadiusX="0.8" RadiusY="0.8"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <!-- Shader state dot colours -->
        <Style x:Key="ShaderDot" TargetType="Ellipse">
            <Setter Property="Width" Value="7"/>
            <Setter Property="Height" Value="7"/>
            <Setter Property="Fill" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Shaders}" Value="Ready">
                    <Setter Property="Fill" Value="{StaticResource GoodBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Shaders}" Value="Recorded">
                    <Setter Property="Fill" Value="{StaticResource GoodBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Shaders}" Value="Outdated">
                    <Setter Property="Fill" Value="{StaticResource WarnBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Shaders}" Value="Checking">
                    <Setter Property="Fill" Value="{StaticResource AccentTextBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ShaderRow" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Shaders}" Value="Unknown">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The cover, or the K mark where a game has none -->
        <DataTemplate x:Key="CoverTemplate">
            <Grid>
                <Border CornerRadius="7" Background="#0B1324" BorderBrush="#1D2B47" BorderThickness="1">
                    <Image Source="pack://application:,,,/Assets/mark.png" Width="44" Opacity="0.55"/>
                </Border>
                <Border CornerRadius="7" Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill"/>
                    </Border.Background>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Game cards over the artwork: translucent, so the selected game's art shows through -->
        <SolidColorBrush x:Key="GameCardBrush" Color="#D8101A2E"/>
        <SolidColorBrush x:Key="GameCardHoverBrush" Color="#E615223A"/>
        <SolidColorBrush x:Key="GameCardSelectedBrush" Color="#EB13244A"/>

        <!-- List view row -->
        <DataTemplate x:Key="RowTemplate">
            <Border x:Name="Card" Height="112" Margin="0,0,10,10" CornerRadius="10" Background="{StaticResource GameCardBrush}"
                    BorderBrush="#2A3A5A" BorderThickness="1" Padding="8" Cursor="Hand">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Width="94" Height="94" Content="{Binding}" ContentTemplate="{StaticResource CoverTemplate}"/>
                    <StackPanel Grid.Column="1" Margin="20,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Subtitle}" FontSize="12.5" Margin="0,7,0,0" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Style="{StaticResource ShaderRow}" Margin="0,8,0,0">
                            <Ellipse Style="{StaticResource ShaderDot}"/>
                            <TextBlock Text="{Binding ShaderText}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <Button x:Name="PlayBtn" Grid.Column="2" Margin="0,0,10,0" Style="{StaticResource RowPlayButton}" Click="RowPlay_Click" Tag="{Binding}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="13" Margin="0,1,9,0"/>
                            <TextBlock Text="Play" FontSize="14"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Card" Property="Background" Value="{StaticResource GameCardHoverBrush}"/>
                    <Setter TargetName="Card" Property="BorderBrush" Value="#26385A"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Card" Property="Background" Value="{StaticResource GameCardSelectedBrush}"/>
                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                    <Setter TargetName="Card" Property="BorderThickness" Value="1.5"/>
                    <Setter TargetName="PlayBtn" Property="Style" Value="{StaticResource PrimaryButton}"/>
                    <Setter TargetName="PlayBtn" Property="Width" Value="110"/>
                    <Setter TargetName="PlayBtn" Property="Height" Value="40"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Exists}" Value="False">
                    <Setter TargetName="Card" Property="Opacity" Value="0.6"/>
                    <Setter TargetName="PlayBtn" Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Grid view tile -->
        <DataTemplate x:Key="TileTemplate">
            <Border x:Name="Card" Width="196" Margin="0,0,14,14" CornerRadius="12" Background="{StaticResource GameCardBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" Padding="8" Cursor="Hand">
                <StackPanel>
                    <Grid Height="178">
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CoverTemplate}"/>
                        <Button x:Name="PlayBtn" Style="{StaticResource PrimaryButton}" Width="54" Height="54" Padding="0" Click="RowPlay_Click" Tag="{Binding}"
                                Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Play">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="18" Margin="3,0,0,0"/>
                        </Button>
                    </Grid>
                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Margin="2,10,2,0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Margin="2,4,2,2" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Style="{StaticResource ShaderRow}" Margin="2,4,2,2">
                        <Ellipse Style="{StaticResource ShaderDot}"/>
                        <TextBlock Text="{Binding ShaderText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Card" Property="Background" Value="{StaticResource GameCardHoverBrush}"/>
                    <Setter TargetName="PlayBtn" Property="Opacity" Value="1"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Card" Property="Background" Value="{StaticResource GameCardSelectedBrush}"/>
                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                    <Setter TargetName="Card" Property="BorderThickness" Value="1.5"/>
                    <Setter TargetName="PlayBtn" Property="Opacity" Value="1"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Exists}" Value="False">
                    <Setter TargetName="Card" Property="Opacity" Value="0.6"/>
                    <Setter TargetName="PlayBtn" Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="RowPanel">
            <VirtualizingStackPanel/>
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="TilePanel">
            <WrapPanel/>
        </ItemsPanelTemplate>

        <Style x:Key="GameItem" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="MouseDoubleClick" Handler="GameItem_DoubleClick"/>
        </Style>

        <!-- Compatibility: a status's colour (in-game, main-menu, logo, doesnt-boot) -->
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="7"/>
            <Setter Property="Height" Value="7"/>
            <Setter Property="Fill" Value="{StaticResource TextMutedBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding}" Value="in-game"><Setter Property="Fill" Value="{StaticResource GoodBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding}" Value="playable"><Setter Property="Fill" Value="{StaticResource GoodBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding}" Value="main-menu"><Setter Property="Fill" Value="{StaticResource AccentTextBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding}" Value="logo"><Setter Property="Fill" Value="{StaticResource WarnBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding}" Value="doesnt-boot"><Setter Property="Fill" Value="{StaticResource BadBrush}"/></DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A platform chip: the OS name and a dot of its status; hidden where the OS has no report -->
        <DataTemplate x:Key="OsChip">
            <Border Background="#121D33" BorderBrush="#1F2E4C" BorderThickness="1" CornerRadius="5" Padding="7,3" Margin="0,0,6,0">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Style="{StaticResource StatusDot}" DataContext="{Binding Status}" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <Style x:Key="StatusPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="11,4"/>
            <Setter Property="Background" Value="#1A2238"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2A3654"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="in-game"><Setter Property="Background" Value="#1A3DDC97"/><Setter Property="BorderBrush" Value="#553DDC97"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="main-menu"><Setter Property="Background" Value="#1A4DA3FF"/><Setter Property="BorderBrush" Value="#554DA3FF"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="logo"><Setter Property="Background" Value="#1AFFB547"/><Setter Property="BorderBrush" Value="#55FFB547"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="doesnt-boot"><Setter Property="Background" Value="#1AFF5D73"/><Setter Property="BorderBrush" Value="#55FF5D73"/></DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A statistics card that filters the list by its status -->
        <Style x:Key="StatCard" TargetType="RadioButton">
            <Setter Property="GroupName" Value="CompatFilter"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{TemplateBinding Foreground}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{TemplateBinding Content}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <TextBlock Text="{TemplateBinding Tag}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardSelectedBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LogItem" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Padding="12,9" Margin="0,0,0,3">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14203A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#18305C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A setting row: control, then a note beside it -->
        <Style x:Key="SideNote" TargetType="TextBlock" BasedOn="{StaticResource Note}">
            <Setter Property="Margin" Value="12,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" BorderBrush="#1A2640" BorderThickness="1">
        <Grid ClipToBounds="True">
            <!-- Ambient glow, as in the KytyPS5 artwork -->
            <Canvas IsHitTestVisible="False">
                <Ellipse Canvas.Left="900" Canvas.Top="-360" Width="1100" Height="760" Opacity="0.22">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#1F6BFF" Offset="0"/>
                            <GradientStop Color="#001F6BFF" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Canvas.Left="-300" Canvas.Top="520" Width="1000" Height="700" Opacity="0.14">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#1E55FF" Offset="0"/>
                            <GradientStop Color="#001E55FF" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Canvas>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="248"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,1,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#F0101B33" Offset="0"/>
                            <GradientStop Color="#E80B1324" Offset="0.45"/>
                            <GradientStop Color="#F0091020" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <!-- Soft glow behind the logo -->
                        <Ellipse Width="300" Height="180" VerticalAlignment="Top" Margin="0,-70,0,0" IsHitTestVisible="False" Opacity="0.24">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#2A7BFF" Offset="0"/>
                                    <GradientStop Color="#002A7BFF" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>

                        <DockPanel Margin="16,30,16,24">
                            <StackPanel DockPanel.Dock="Top">
                                <Image Source="pack://application:,,,/Assets/logo.png" Width="147" HorizontalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality">
                                    <!-- A soft dark shadow lifts the logo off the glow behind it (a blue glow washed the blue out) -->
                                    <Image.Effect>
                                        <DropShadowEffect Color="#000814" BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.75"/>
                                    </Image.Effect>
                                </Image>
                                <!-- Divider fading out at both ends -->
                                <Rectangle Height="1" Margin="10,28,10,22">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#002A4170" Offset="0"/>
                                            <GradientStop Color="#FF2A4170" Offset="0.5"/>
                                            <GradientStop Color="#002A4170" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <TextBlock Text="MENU" Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" FontWeight="SemiBold" Margin="14,0,0,12"/>
                            </StackPanel>

                            <!-- The launcher card: its version and the builds' update state (a click opens Settings → Emulators) -->
                            <Button DockPanel.Dock="Bottom" x:Name="SidebarCard" Click="SidebarCard_Click" Cursor="Hand" FocusVisualStyle="{x:Null}" Height="Auto" MinHeight="0" Padding="0" Margin="0"
                                    ToolTip="KytyPS5 builds: Settings → Emulators">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Card" CornerRadius="12" Padding="14,12" BorderThickness="1" BorderBrush="#1A2946">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#C0122039" Offset="0"/>
                                                    <GradientStop Color="#C00C1528" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Card" Property="BorderBrush" Value="#2E4A7A"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="KytyPS5 Launcher" Foreground="{StaticResource TextBrush}" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="VersionText" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <Rectangle Height="1" Fill="#1A2946" Margin="0,11,0,9"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Ellipse x:Name="SidebarDot" Width="7" Height="7" VerticalAlignment="Center" Fill="{StaticResource TextMutedBrush}">
                                            <Ellipse.Effect><DropShadowEffect x:Name="SidebarDotGlow" Color="#3DDC97" BlurRadius="8" ShadowDepth="0" Opacity="0"/></Ellipse.Effect>
                                        </Ellipse>
                                        <TextBlock x:Name="SidebarStatus" Text="PS5 emulator for PC" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" Margin="8,0,0,0"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>

                            <StackPanel>
                            <RadioButton x:Name="NavGames" Style="{StaticResource NavButton}" Tag="&#xE8F1;" Content="Games" IsChecked="True" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavCompat" Style="{StaticResource NavButton}" Tag="&#xE73E;" Content="Compatibility" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" Tag="&#xE713;" Content="Settings" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavLogs" Style="{StaticResource NavButton}" Tag="&#xE8A5;" Content="Logs" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavAbout" Style="{StaticResource NavButton}" Tag="" local:NavIcon.Image="{StaticResource InfoIcon}" Content="About" Checked="Nav_Checked"/>
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                </Border>

                <!-- Content -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Selected game's artwork behind the library -->
                    <Image x:Name="Backdrop" Grid.RowSpan="2" Stretch="UniformToFill" VerticalAlignment="Top" HorizontalAlignment="Left"
                           Opacity="0" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#F0000000" Offset="0"/>
                                <GradientStop Color="#B0000000" Offset="0.45"/>
                                <GradientStop Color="#50000000" Offset="0.8"/>
                                <GradientStop Color="#28000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Image.OpacityMask>
                    </Image>
                    <!-- A scrim over the artwork: darker to the left (the list), so text stays readable while the art shows -->
                    <Rectangle x:Name="BackdropScrim" Grid.RowSpan="2" IsHitTestVisible="False" Opacity="{Binding Opacity, ElementName=Backdrop}">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#C80A1020" Offset="0"/>
                                <GradientStop Color="#A00A1020" Offset="0.45"/>
                                <GradientStop Color="#5A0A1020" Offset="0.66"/>
                                <GradientStop Color="#380A1020" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <!-- ...and darker at the top, behind the title, the search and the window buttons -->
                    <Rectangle Grid.RowSpan="2" Height="190" VerticalAlignment="Top" IsHitTestVisible="False" Opacity="{Binding Opacity, ElementName=Backdrop}">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#D00A1020" Offset="0"/>
                                <GradientStop Color="#700A1020" Offset="0.5"/>
                                <GradientStop Color="#000A1020" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- Title bar -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <StackPanel.Effect><DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="0" Opacity="0.85"/></StackPanel.Effect>
                        <Button x:Name="MinButton" Style="{StaticResource CaptionButton}" Content="&#xE921;" WindowChrome.IsHitTestVisibleInChrome="True" Click="Min_Click" ToolTip="Minimize"/>
                        <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" WindowChrome.IsHitTestVisibleInChrome="True" Click="Max_Click" ToolTip="Maximize"/>
                        <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click" ToolTip="Close"/>
                    </StackPanel>

                    <!-- ===== Games ===== -->
                    <Grid x:Name="PageGames" Grid.Row="1" Margin="34,0,26,26">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="26"/>
                            <ColumnDefinition Width="452"/>
                        </Grid.ColumnDefinitions>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Game Library" FontSize="30" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Grid Grid.Column="1" Margin="40,0,16,0" MaxWidth="400" HorizontalAlignment="Stretch">
                                    <TextBox x:Name="SearchBox" Tag="Search games..." Padding="36,0,10,0" Height="40" TextChanged="Search_Changed"/>
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="14" HorizontalAlignment="Left" Margin="14,0,0,0"
                                               Foreground="{StaticResource TextSecondaryBrush}" IsHitTestVisible="False"/>
                                </Grid>
                                <Button Grid.Column="2" Click="AddGame_Click" ToolTip="Add a game: its folder (eboot.bin, sce_sys) or a .zar archive of it">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,9,0"/>
                                        <TextBlock Text="Add game"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- No KytyPS5 build yet: download the official one, or add a folder -->
                            <Border x:Name="NoBuildBanner" Grid.Row="1" Margin="0,18,10,0" CornerRadius="12" Padding="20,16" BorderThickness="1" BorderBrush="#3A2584FF" Visibility="Collapsed">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#E6132449" Offset="0"/>
                                        <GradientStop Color="#D90F182B" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7FC;" FontSize="26" Foreground="{StaticResource AccentTextBrush}" VerticalAlignment="Top" Margin="0,2,16,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Get the KytyPS5 emulator" FontSize="16" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="NoBuildText" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,5,0,0"/>
                                        <WrapPanel Margin="0,12,0,0">
                                            <Button x:Name="NoBuildDownload" Style="{StaticResource PrimaryButton}" Click="DownloadBuild_Click" Margin="0,0,10,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="13" Margin="0,0,9,0"/>
                                                    <TextBlock Text="Download KytyPS5"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Click="EmulatorAdd_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="13" Margin="0,0,9,0"/>
                                                    <TextBlock Text="I have KytyPS5: choose its folder…"/>
                                                </StackPanel>
                                            </Button>
                                        </WrapPanel>
                                        <TextBlock x:Name="NoBuildStatus" Foreground="{StaticResource AccentTextBrush}" FontSize="12.5" Margin="0,10,0,0" Visibility="Collapsed"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,10,14">
                                <TextBlock Text="Sort by:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" FontSize="13" Margin="0,0,8,0"/>
                                <ComboBox x:Name="SortBox" Width="150" Height="32" SelectionChanged="Sort_Changed">
                                    <ComboBoxItem Content="Name"/>
                                    <ComboBoxItem Content="Recently played"/>
                                </ComboBox>
                                <Border Background="{StaticResource InputBrush}" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="7" Margin="14,0,0,0" Padding="2">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="ViewTiles" Style="{StaticResource SegmentButton}" Content="&#xF0E2;" GroupName="View" ToolTip="Grid" Checked="View_Checked"/>
                                        <RadioButton x:Name="ViewRows" Style="{StaticResource SegmentButton}" Content="&#xE8FD;" GroupName="View" ToolTip="List" IsChecked="True" Checked="View_Checked"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <ListBox x:Name="GameList" Grid.Row="3" Foreground="{StaticResource TextBrush}" Background="Transparent" BorderThickness="0" Padding="0"
                                     ItemContainerStyle="{StaticResource GameItem}" ItemTemplate="{StaticResource RowTemplate}" ItemsPanel="{StaticResource RowPanel}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False"
                                     SelectionChanged="GameList_SelectionChanged" KeyDown="GameList_KeyDown">
                                <ListBox.ContextMenu>
                                    <ContextMenu x:Name="GameMenu" Opened="GameMenu_Opened">
                                        <MenuItem Header="Play" Tag="&#xE768;" Click="MenuPlay_Click"/>
                                        <MenuItem Header="Open game folder" Tag="&#xE838;" Click="MenuOpenFolder_Click"/>
                                        <MenuItem Header="Check shaders again" Tag="&#xE72C;" Click="MenuCheck_Click"/>
                                        <Separator/>
                                        <MenuItem Header="Remove from library" Tag="&#xE74D;" Click="MenuRemove_Click"/>
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                            </ListBox>

                            <!-- Empty library -->
                            <Border x:Name="EmptyState" Grid.Row="3" Style="{StaticResource Panel}" VerticalAlignment="Top" Padding="36,40" Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center">
                                    <Image Source="pack://application:,,,/Assets/mark.png" Width="64" HorizontalAlignment="Center" Opacity="0.9"/>
                                    <TextBlock x:Name="EmptyTitle" Text="No games yet" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,20,0,0"/>
                                    <TextBlock x:Name="EmptyText" Text="Add the game dump: the folder with eboot.bin and sce_sys, or a .zar archive of it."
                                               Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420" Margin="0,8,0,22"/>
                                    <Button x:Name="EmptyAdd" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Click="AddGame_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,9,0"/>
                                            <TextBlock Text="Add game"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Launcher settings panel -->
                        <Border Grid.Column="2" Style="{StaticResource Panel}" Margin="0,4,0,0" Background="#D80F182B">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Margin="26,22,18,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="38" Height="38" CornerRadius="9" Background="#14213A" BorderBrush="#22345A" BorderThickness="1">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" FontSize="18" Foreground="{StaticResource AccentTextBrush}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="13,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="Game Settings" FontSize="18" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="GameSettingsFor" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Button x:Name="GameSettingsMore" Grid.Column="2" Style="{StaticResource IconButton}" Click="GameSettingsMore_Click" ToolTip="More">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE712;" FontSize="15"/>
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Apply to all games" Tag="&#xE8C8;" Click="ApplyAll_Click"/>
                                                <MenuItem Header="Reset to defaults" Tag="&#xE7A7;" Click="ResetGame_Click"/>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </Grid>

                                <ScrollViewer x:Name="GameSettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="26,0,18,8" Margin="0,0,6,0">
                                    <StackPanel Margin="0,0,8,12">
                                        <TextBlock Style="{StaticResource Label}" Text="Game folder"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="GameFolder" IsReadOnly="True" Foreground="{StaticResource TextSecondaryBrush}" Tag="No game chosen"/>
                                            <Button x:Name="BrowseButton" Grid.Column="1" Width="42" Padding="0" Margin="8,0,0,0" Click="Browse_Click" ToolTip="Choose the game folder or a .zar archive">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="15"/>
                                                <Button.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Game folder…" Tag="&#xE8B7;" Click="BrowseFolder_Click"/>
                                                        <MenuItem Header=".zar archive…" Tag="&#xE7B8;" Click="BrowseZar_Click"/>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                        </Grid>
                                        <TextBlock x:Name="GameNote" Style="{StaticResource Note}"/>

                                        <TextBlock Style="{StaticResource Label}" Text="Emulator"/>
                                        <ComboBox x:Name="EmulatorBox" SelectionChanged="Emulator_Changed">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock x:Name="EmulatorNote" Style="{StaticResource Note}"/>

                                        <TextBlock Style="{StaticResource Label}" Text="Resolution"/>
                                        <ComboBox x:Name="Resolution" SelectionChanged="Setting_Changed"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <CheckBox x:Name="Fullscreen" Content="Fullscreen" Click="Setting_Changed"/>
                                            <CheckBox x:Name="KeepAspect" Content="Keep 16:9 (black bars)" Margin="26,7,0,7" Click="Setting_Changed"/>
                                        </StackPanel>

                                        <TextBlock Style="{StaticResource Label}" Text="Console language"/>
                                        <ComboBox x:Name="LanguageBox" SelectionChanged="Setting_Changed"/>

                                        <StackPanel Margin="0,12,0,0">
                                            <CheckBox x:Name="RedZone" Content="Red-zone protection (recommended)" Click="Setting_Changed"/>
                                            <CheckBox x:Name="Fps120" Content="Up to 120 fps (the game's own frames; movies stay at 60)" Click="Setting_Changed"/>
                                            <CheckBox x:Name="VSync" Content="VSync (no screen tearing; adaptive sync displays keep it)" Click="Setting_Changed"/>
                                            <CheckBox x:Name="Hdr" Click="Setting_Changed">
                                                <TextBlock TextWrapping="Wrap">HDR (turn on <Run Foreground="{StaticResource AccentTextBrush}">"Use HDR"</Run> in Windows display settings first)</TextBlock>
                                            </CheckBox>
                                            <CheckBox x:Name="SkipLogos" Content="Skip boot logos (in games that support it)" Click="Setting_Changed"/>
                                        </StackPanel>


                                        <TextBlock Style="{StaticResource Label}" Text="Render height"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="RenderHeight" SelectionChanged="Setting_Changed"/>
                                            <TextBlock x:Name="RenderNote" Grid.Column="1" Style="{StaticResource SideNote}" Text="Demon's Souls 3D; lower = faster, less sharp"/>
                                            <TextBlock x:Name="RenderOnly" Grid.Column="1" Style="{StaticResource SideNote}" Visibility="Collapsed" Foreground="{StaticResource WarnBrush}" Text="Demon's Souls only: not used for this game"/>
                                        </Grid>

                                        <TextBlock Style="{StaticResource Label}" Text="Aspect ratio"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="Ratio" SelectionChanged="Setting_Changed"/>
                                            <TextBlock x:Name="RatioNote" Grid.Column="1" Style="{StaticResource SideNote}" Text="the 3D wider (more to the sides); the HUD keeps its shape, menus stretch, movies stay 16:9"/>
                                            <TextBlock x:Name="RatioOnly" Grid.Column="1" Style="{StaticResource SideNote}" Visibility="Collapsed" Foreground="{StaticResource WarnBrush}" Text="Demon's Souls only: not used for this game"/>
                                        </Grid>

                                        <TextBlock Style="{StaticResource Label}" Text="Graphics"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="Quality" SelectionChanged="Setting_Changed">
                                                <ComboBox.ToolTip>
                                                    <TextBlock>Standard: the PS5's picture. With less than 12 GB of video memory, large textures leave out their largest level (half the size per side) so that they fit.<LineBreak/>Low: simpler shadows and distant detail, textures half the size per side.<LineBreak/>Lowest: simpler still, textures a quarter the size per side.</TextBlock>
                                                </ComboBox.ToolTip>
                                            </ComboBox>
                                            <TextBlock x:Name="QualityNote" Grid.Column="1" Style="{StaticResource SideNote}" Text="simpler shadows and detail, smaller textures; faster on weaker PCs"/>
                                            <TextBlock x:Name="QualityOnly" Grid.Column="1" Style="{StaticResource SideNote}" Visibility="Collapsed" Foreground="{StaticResource WarnBrush}" Text="Demon's Souls only: not used for this game"/>
                                        </Grid>

                                        <TextBlock Style="{StaticResource Label}" Text="Frame generation"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="FrameGen" SelectionChanged="Setting_Changed">
                                                <ComboBox.ToolTip>
                                                    <TextBlock>Shown frames = the game's frames x the multiplier. With VSync on, they are capped at the display's refresh (a 60 Hz display at 2x runs the game at 30 fps). The game's frames stay at 60 with "Up to 120 fps" too: frame generation needs them evenly spaced.</TextBlock>
                                                </ComboBox.ToolTip>
                                            </ComboBox>
                                            <TextBlock x:Name="FrameGenNote" Grid.Column="1" Style="{StaticResource SideNote}"/>
                                        </Grid>

                                        <TextBlock Style="{StaticResource Label}" Text="Overlay"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="Overlay" SelectionChanged="Setting_Changed"/>
                                            <TextBlock x:Name="OverlayNote" Grid.Column="1" Style="{StaticResource SideNote}" Text="top right: frame rate and frame times; detailed: GPU, CPU, memory"/>
                                        </Grid>
                                        <TextBlock Style="{StaticResource Label}" Text="Stability and compatibility"/>
                                        <StackPanel>
                                            <CheckBox x:Name="SafeGpu" Click="Setting_Changed"
                                                      Content="Safe GPU mode: prevents GPU-hang crashes and blue screens, but the frame rate is about 37% lower">
                                                <CheckBox.ToolTip>
                                                    <TextBlock>Compute work runs one dispatch after another instead of overlapping on the graphics card.<LineBreak/>It stops 'device lost' crashes, the screen going black while the driver restarts (TDR) and VIDEO_TDR_FAILURE blue screens.<LineBreak/>Leave it off if the game runs without such crashes. (Demon's Souls build: KYTY_COMPUTE_CHAIN=0; u59 builds: KYTY_DISPATCH_OVERLAP=0.)</TextBlock>
                                                </CheckBox.ToolTip>
                                            </CheckBox>
                                            <CheckBox x:Name="AmdCpu" Click="Setting_Changed" Content="AMD CPU patch: the game's instructions that differ on AMD processors"/>
                                            <CheckBox x:Name="SyncRaw" Click="Setting_Changed" Content="Accurate texture synchronization (can fix missing textures and wrong transparency)"/>
                                            <CheckBox x:Name="ZMask" Click="Setting_Changed" Content="Support ZMask (can restore missing geometry)"/>
                                            <CheckBox x:Name="ReadbackLinear" Click="Setting_Changed" Content="Read back writable linear images (slower; for games that read them on the CPU)"/>
                                            <CheckBox x:Name="Tessellation" Click="Setting_Changed" Content="Tessellation (experimental; unsupported tessellation can crash)"/>
                                        </StackPanel>
                                        <TextBlock x:Name="CompatNote" Style="{StaticResource Note}"/>

                                        <TextBlock Style="{StaticResource Label}" Text="Add-ons and cheats"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="AddCont" IsReadOnly="True" Foreground="{StaticResource TextSecondaryBrush}" Tag="Add-ons (DLC) folder: none"/>
                                            <Button x:Name="AddContPick" Grid.Column="1" Width="42" Padding="0" Margin="8,0,0,0" Click="AddCont_Click" ToolTip="The folder with the extracted add-on (DLC) packages">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="15"/>
                                            </Button>
                                            <Button x:Name="AddContClear" Grid.Column="2" Width="42" Padding="0" Margin="6,0,0,0" Click="AddContClear_Click" ToolTip="No add-ons">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="13"/>
                                            </Button>
                                        </Grid>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="GamePatch" IsReadOnly="True" Foreground="{StaticResource TextSecondaryBrush}" Tag="Cheat file (ETAHen .json): none"/>
                                            <Button x:Name="GamePatchPick" Grid.Column="1" Width="42" Padding="0" Margin="8,0,0,0" Click="GamePatch_Click" ToolTip="An ETAHen cheat file (.json)">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8E5;" FontSize="15"/>
                                            </Button>
                                            <Button x:Name="GamePatchClear" Grid.Column="2" Width="42" Padding="0" Margin="6,0,0,0" Click="GamePatchClear_Click" ToolTip="No cheats">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="13"/>
                                            </Button>
                                        </Grid>
                                        <TextBlock x:Name="ContentNote" Style="{StaticResource Note}"/>

                                        <TextBlock Style="{StaticResource Label}" Text="Shaders"/>
                                        <Border Background="{StaticResource InputBrush}" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,9">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DataContext="{Binding SelectedItem, ElementName=GameList}">
                                                    <Ellipse Style="{StaticResource ShaderDot}"/>
                                                    <TextBlock x:Name="ShaderStatusText" FontSize="12.5" TextWrapping="Wrap" MaxWidth="330"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Style="{StaticResource IconButton}" Click="MenuCheck_Click" ToolTip="Check again">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                        <TextBlock x:Name="PrecompileOther" Style="{StaticResource Note}" Visibility="Collapsed"
                                                   Text="This game is warmed up from recorded play: the emulator records every shader and pipeline it meets and compiles them before the next start, so a place stutters only the first time. (The static precompile reads Demon's Souls' engine files only.)"/>
                                        <CheckBox x:Name="EbootPrecompile" Margin="0,8,0,0" Click="Setting_Changed"
                                                  Content="Experimental: precompile the compute shaders in the game's executable"/>
                                        <TextBlock x:Name="EbootNote" Style="{StaticResource Note}" Margin="30,0,0,0"
                                                   Text="KytyPS5 zipeek only, buffer strides read at run time. Measured on Astro Bot without a gain; the first start after a change compiles the compute pipelines again."/>
                                        <Button x:Name="PageHints" HorizontalAlignment="Left" Margin="0,8,0,0" Click="ExportHints_Click"
                                                ToolTip="The shaders your play recorded, without the game's code, as my-hints-&lt;game&gt;.hints: attached to a GitHub issue, the next packages precompile them for everyone.">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xEDE1;" FontSize="13" Margin="0,0,8,0"/>
                                                <TextBlock Text="Export shader hints" FontSize="12.5"/>
                                            </StackPanel>
                                        </Button>

                                        <TextBlock Style="{StaticResource Note}" Margin="0,16,0,0"
                                                   Text="Options this game's emulator does not take are greyed out and not passed to it. The profile, controller, GPU, notifications and debug options are in Settings, the same for every game."/>
                                    </StackPanel>
                                </ScrollViewer>

                                <Border Grid.Row="2" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,1,0,0" Margin="22,0" Padding="0,18,0,22">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.25*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="0.85*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="LaunchButton" Style="{StaticResource PrimaryButton}" Height="50" Padding="6,0" Click="Launch_Click" ToolTip="Start the selected game (Enter)">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="14" Margin="0,1,9,0"/>
                                                <TextBlock Text="Launch" FontSize="15"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="PanelPrecompile" Grid.Column="2" Height="50" Padding="6,0" Click="Precompile_Click" ToolTipService.ShowOnDisabled="True">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE9F5;" FontSize="15" Margin="0,0,8,0"/>
                                                <TextBlock Text="Precompile&#x0a;shaders" FontSize="12.5" LineHeight="15" LineStackingStrategy="BlockLineHeight"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="4" Height="50" Padding="6,0" Click="LogsPage_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" FontSize="14" Margin="0,0,8,0"/>
                                                <TextBlock Text="Logs"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="6" Height="50" Padding="6,0" Click="Readme_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" FontSize="14" Margin="0,0,8,0"/>
                                                <TextBlock Text="README"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ===== Compatibility ===== -->
                    <Grid x:Name="PageCompat" Grid.Row="1" Visibility="Collapsed" Margin="34,0,26,26">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="Compatibility" FontSize="30" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Ellipse x:Name="CompatLive" Width="8" Height="8" Fill="{StaticResource GoodBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="CompatUpdated" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="CompatRefresh" Click="CompatRefresh_Click" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13" Margin="0,0,9,0"/>
                                        <TextBlock Text="Check now"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="CompatSite_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" FontSize="13" Margin="0,0,9,0"/>
                                        <TextBlock Text="kytyps5.github.io"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Statistics: the share of each status, and cards that filter the list -->
                        <Border Grid.Row="1" Height="8" CornerRadius="4" Margin="0,22,0,14" ClipToBounds="True" Background="#141E33">
                            <Grid x:Name="CompatBar">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="BarInGame" Width="0*"/>
                                    <ColumnDefinition x:Name="BarMenu" Width="0*"/>
                                    <ColumnDefinition x:Name="BarLogo" Width="0*"/>
                                    <ColumnDefinition x:Name="BarNoBoot" Width="0*"/>
                                </Grid.ColumnDefinitions>
                                <Rectangle Grid.Column="0" Fill="{StaticResource GoodBrush}"/>
                                <Rectangle Grid.Column="1" Fill="{StaticResource AccentTextBrush}"/>
                                <Rectangle Grid.Column="2" Fill="{StaticResource WarnBrush}"/>
                                <Rectangle Grid.Column="3" Fill="{StaticResource BadBrush}"/>
                            </Grid>
                        </Border>
                        <UniformGrid Grid.Row="2" Rows="1" Columns="5" Margin="0,0,-12,16">
                            <RadioButton x:Name="StatAll" Style="{StaticResource StatCard}" Content="All tested games" Foreground="{StaticResource TextSecondaryBrush}" IsChecked="True" Checked="CompatFilter_Changed"/>
                            <RadioButton x:Name="StatInGame" Style="{StaticResource StatCard}" Content="In-game" Foreground="{StaticResource GoodBrush}" Checked="CompatFilter_Changed"/>
                            <RadioButton x:Name="StatMenu" Style="{StaticResource StatCard}" Content="Main menu" Foreground="{StaticResource AccentTextBrush}" Checked="CompatFilter_Changed"/>
                            <RadioButton x:Name="StatLogo" Style="{StaticResource StatCard}" Content="Logo" Foreground="{StaticResource WarnBrush}" Checked="CompatFilter_Changed"/>
                            <RadioButton x:Name="StatNoBoot" Style="{StaticResource StatCard}" Content="Doesn't boot" Foreground="{StaticResource BadBrush}" Checked="CompatFilter_Changed"/>
                        </UniformGrid>

                        <Grid Grid.Row="3" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MaxWidth="420"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid>
                                <TextBox x:Name="CompatSearch" Tag="Search by title or ID…" Padding="36,0,10,0" TextChanged="CompatSearch_Changed"/>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="14" HorizontalAlignment="Left" Margin="14,0,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}" IsHitTestVisible="False"/>
                            </Grid>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                                <CheckBox x:Name="CompatMine" Content="My games" Margin="0" Click="CompatFilter_Changed"/>
                                <CheckBox x:Name="CompatChanged" Content="New and changed this week" Margin="22,0,0,0" Click="CompatFilter_Changed"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <TextBlock Text="Sort by:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" FontSize="13" Margin="0,0,8,0"/>
                                <ComboBox x:Name="CompatSort" Width="170" Height="34" SelectionChanged="CompatSort_Changed">
                                    <ComboBoxItem Content="Recently tested"/>
                                    <ComboBoxItem Content="Best status"/>
                                    <ComboBoxItem Content="Name"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <ListBox x:Name="CompatList" Grid.Row="4" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}"
                                 ItemContainerStyle="{StaticResource GameItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Card" Height="78" Margin="0,0,10,8" CornerRadius="10" Background="{StaticResource CardBrush}"
                                            BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" Padding="8,8,14,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="60" Height="60">
                                                <Border CornerRadius="7" Background="#0B1324" BorderBrush="#1D2B47" BorderThickness="1">
                                                    <Image Source="pack://application:,,,/Assets/mark.png" Width="28" Opacity="0.5"/>
                                                </Border>
                                                <Border CornerRadius="7">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill"/>
                                                    </Border.Background>
                                                </Border>
                                            </Grid>
                                            <StackPanel Grid.Column="1" Margin="16,0,12,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="560"/>
                                                    <Border x:Name="ChangeBadge" CornerRadius="4" Padding="6,1" Margin="10,0,0,0" Background="{StaticResource AccentBrush}" VerticalAlignment="Center"
                                                            ToolTip="{Binding ChangeTip}" Visibility="Collapsed">
                                                        <TextBlock Text="{Binding ChangeText}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                                    </Border>
                                                    <Border x:Name="MineBadge" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" BorderBrush="{StaticResource AccentTextBrush}" BorderThickness="1"
                                                            VerticalAlignment="Center" Visibility="Collapsed">
                                                        <TextBlock Text="IN YOUR LIBRARY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentTextBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0">
                                                    <Run Text="{Binding TitleId, Mode=OneWay}"/><Run Text="  •  "/><Run Text="{Binding TestedText, Mode=OneWay}"/><Run Text="  •  "/><Run Text="{Binding ReportsText, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <ItemsControl Grid.Column="2" ItemsSource="{Binding Platforms}" ItemTemplate="{StaticResource OsChip}" VerticalAlignment="Center" Margin="0,0,14,0" Focusable="False">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                            <Border Grid.Column="3" Style="{StaticResource StatusPill}" VerticalAlignment="Center" MinWidth="104">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Ellipse Style="{StaticResource StatusDot}" DataContext="{Binding Status}" Margin="0,0,7,0"/>
                                                    <TextBlock Text="{Binding StatusText}" FontSize="12.5" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Border>
                                            <Button Grid.Column="4" Style="{StaticResource IconButton}" Margin="8,0,0,0" Tag="{Binding Url}" Click="CompatOpen_Click" ToolTip="Reports on kytyps5.github.io">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" FontSize="13"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter TargetName="Card" Property="Background" Value="{StaticResource CardHoverBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding InLibrary}" Value="True">
                                            <Setter TargetName="MineBadge" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="Card" Property="BorderBrush" Value="#2E4D80"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Change}" Value="new">
                                            <Setter TargetName="ChangeBadge" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Change}" Value="improved">
                                            <Setter TargetName="ChangeBadge" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="ChangeBadge" Property="Background" Value="#2BA36F"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Change}" Value="regressed">
                                            <Setter TargetName="ChangeBadge" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="ChangeBadge" Property="Background" Value="#C2414F"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="CompatEmpty" Grid.Row="4" Foreground="{StaticResource TextMutedBrush}" Margin="4,10" Visibility="Collapsed" TextWrapping="Wrap"/>
                    </Grid>

                    <!-- ===== Settings ===== -->
                    <ScrollViewer x:Name="PageSettings" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="34,0,26,26">
                        <StackPanel MaxWidth="900" HorizontalAlignment="Left" Width="900">
                            <TextBlock Text="Settings" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,6"/>
                            <TextBlock Text="Settings for every game: emulators, user profile, controller, system, frame generation, debug and the launcher. Each game's own options (resolution, graphics, Safe GPU mode, compatibility, shaders…) are in its Game Settings on the Games page." TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,22"/>

                            <!-- Emulators -->
                            <Border Style="{StaticResource Panel}" Padding="26,22" Margin="0,0,0,18">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;" FontSize="18" Foreground="{StaticResource AccentTextBrush}"/>
                                        <TextBlock Text="Emulators" FontSize="17" FontWeight="SemiBold" Margin="12,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Note}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,10,0,0"
                                               Text="The KytyPS5 builds your games run on, each in its own folder: the official KytyPS5 release, or community builds made for particular games. Each game chooses its build in its Game Settings; the launcher reads what each build supports and gives a game only those options."/>
                                    <ItemsControl x:Name="EmulatorList" Margin="0,16,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource InputBrush}" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Image Source="pack://application:,,,/Assets/mark.png" Width="26" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                                            <TextBlock Text="{Binding Details}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                                            <!-- Updates: the state, then Check / Update, or the repository to enter for an unknown build -->
                                                            <StackPanel x:Name="UpdateRow" Orientation="Horizontal" Margin="0,8,0,0">
                                                                <Ellipse x:Name="UpdateDot" Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{StaticResource TextMutedBrush}"/>
                                                                <TextBlock Text="{Binding UpdateStatus}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="460"/>
                                                                <Button x:Name="UpdateBtn" Style="{StaticResource PrimaryButton}" Padding="12,0" Height="28" Margin="12,0,0,0" Click="BuildUpdate_Click" Tag="{Binding}" Visibility="Collapsed">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="12" Margin="0,0,7,0"/>
                                                                        <TextBlock Text="Update" FontSize="12.5"/>
                                                                    </StackPanel>
                                                                </Button>
                                                                <Button x:Name="NotesBtn" Padding="10,0" Height="28" Margin="8,0,0,0" Click="BuildNotes_Click" Tag="{Binding}" Visibility="Collapsed" ToolTip="The release page on GitHub: what changed">
                                                                    <TextBlock Text="What's new" FontSize="12.5"/>
                                                                </Button>
                                                            </StackPanel>
                                                            <Grid x:Name="RepoRow" Margin="0,8,0,0" Visibility="Collapsed" MaxWidth="560" HorizontalAlignment="Left">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBox Text="{Binding RepoInput, UpdateSourceTrigger=PropertyChanged}" Tag="This build's GitHub repository, e.g. github.com/owner/KytyPS5" Height="32"/>
                                                                <Button Grid.Column="1" Padding="12,0" Height="32" Margin="8,0,0,0" Click="BuildSource_Click" Tag="{Binding}">
                                                                    <TextBlock Text="Set update source" FontSize="12.5"/>
                                                                </Button>
                                                            </Grid>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                                            <Button x:Name="CheckBtn" Style="{StaticResource IconButton}" Click="BuildCheck_Click" Tag="{Binding}" ToolTip="Check for updates">
                                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13"/>
                                                            </Button>
                                                            <Button x:Name="RemoveBtn" Style="{StaticResource IconButton}" Click="EmulatorRemove_Click" Tag="{Binding}" ToolTip="Remove from the list (the folder is untouched)">
                                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="14"/>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding BuiltIn}" Value="True">
                                                        <Setter TargetName="RemoveBtn" Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding UpdateAvailable}" Value="True">
                                                        <Setter TargetName="UpdateBtn" Property="Visibility" Value="Visible"/>
                                                        <Setter TargetName="NotesBtn" Property="Visibility" Value="Visible"/>
                                                        <Setter TargetName="UpdateDot" Property="Fill" Value="{StaticResource AccentBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding NeedsRepo}" Value="True">
                                                        <Setter TargetName="RepoRow" Property="Visibility" Value="Visible"/>
                                                        <Setter TargetName="UpdateDot" Property="Fill" Value="{StaticResource WarnBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding UpdateBusy}" Value="True">
                                                        <Setter TargetName="UpdateBtn" Property="IsEnabled" Value="False"/>
                                                        <Setter TargetName="CheckBtn" Property="IsEnabled" Value="False"/>
                                                        <Setter TargetName="RemoveBtn" Property="IsEnabled" Value="False"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Updatable}" Value="False">
                                                        <Setter TargetName="CheckBtn" Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <WrapPanel Margin="0,8,0,0">
                                        <Button Click="EmulatorAdd_Click" Margin="0,0,10,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,9,0"/>
                                                <TextBlock Text="Add KytyPS5 build…"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="DownloadBuildBtn" Style="{StaticResource PrimaryButton}" Click="DownloadBuild_Click" Margin="0,0,10,0" Visibility="Collapsed">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="12" Margin="0,0,9,0"/>
                                                <TextBlock Text="Download KytyPS5"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="CheckAllBtn" Click="BuildCheckAll_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="12" Margin="0,0,9,0"/>
                                                <TextBlock Text="Check for updates"/>
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                    <CheckBox x:Name="CheckUpdates" Margin="0,14,0,4" Click="Setting_Changed" Content="Check for updates of the builds when the launcher starts"/>
                                    <TextBlock Style="{StaticResource Note}" Margin="30,0,0,0"
                                               Text="From each build's GitHub releases (the official KytyPS5, Jetsku's and chenxiao07's builds are known; for another build enter its repository). An update downloads the Windows package, checks its SHA-256 digest and replaces the program files; saves, shader caches and settings stay, and the replaced files are kept in the build's _Update\backup. A build of your own without releases is not updated."/>
                                </StackPanel>
                            </Border>

                            <!-- Shaders: what holds for every game (a game's own shader state and precompile are in its Game Settings) -->
                            <Border Style="{StaticResource Panel}" Padding="26,22" Margin="0,0,0,18">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE9F5;" FontSize="18" Foreground="{StaticResource AccentTextBrush}"/>
                                        <TextBlock Text="Shader precompile" FontSize="17" FontWeight="SemiBold" Margin="12,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Note}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,10,0,0"
                                               Text="Compiling the game's shaders and pipelines ahead keeps it from stuttering while it meets new ones. Each game's state and its Precompile shaders button are in its Game Settings on the Games page; these options hold for every game."/>
                                    <CheckBox x:Name="PrecompilePrompt" Margin="0,16,0,4" Click="PrecompilePrompt_Click"
                                              Content="Before playing, offer to precompile when a game's shaders are not precompiled for this GPU"/>
                                    <TextBlock Style="{StaticResource Note}" Margin="30,0,0,0" Text="Builds that precompile before playing (such as chenxiao07's Demon's Souls build); other builds compile the shaders as the game meets them."/>
                                    <CheckBox x:Name="ECores" Margin="0,12,0,4" Click="Setting_Changed"
                                              Content="Precompile on the efficiency cores only (slower, the PC stays responsive)"/>
                                    <TextBlock Style="{StaticResource Note}" Margin="30,0,0,0" Text="The static precompile of a Demon's Souls build; Prepare shaders uses every core."/>
                                </StackPanel>
                            </Border>

                            <!-- User profile -->
                            <Border Style="{StaticResource Panel}" Padding="26,22" Margin="0,0,0,18">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE77B;" FontSize="18" Foreground="{StaticResource AccentTextBrush}"/>
                                        <TextBlock Text="User profile" FontSize="17" FontWeight="SemiBold" Margin="12,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Note}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,10,0,0"
                                               Text="The local PS5 user the games see (builds that take --user-name and --user-id)."/>
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="260"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="User name" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBox x:Name="UserName" Grid.Column="1" Tag="Kyty" MaxLength="16" LostFocus="Setting_Changed"/>
                                        <TextBlock Grid.Column="2" Style="{StaticResource SideNote}" Text="1-16 characters; empty: Kyty"/>
                                        <TextBlock Grid.Row="1" Text="User ID" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0"/>
                                        <TextBox x:Name="UserId" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" LostFocus="Setting_Changed"/>
                                        <TextBlock x:Name="UserIdNote" Grid.Row="1" Grid.Column="2" Style="{StaticResource SideNote}" Margin="12,8,0,0" Text="default 1000; not 254 or 255"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Controller -->
                            <Border Style="{StaticResource Panel}" Padding="26,22" Margin="0,0,0,18">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Our controller artwork in the accent colour, as the glyph icons -->
                                        <Rectangle Width="21" Height="21" Fill="{StaticResource AccentTextBrush}" VerticalAlignment="Center">
                                            <Rectangle.OpacityMask>
                                                <ImageBrush ImageSource="pack://application:,,,/Assets/controller.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Rectangle.OpacityMask>
                                        </Rectangle>
                                        <TextBlock Text="Controller" FontSize="17" FontWeight="SemiBold" Margin="12,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Note}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,10,0,0"
                                               Text="DualSense options of the upstream KytyPS5 (0.3.0 and newer); builds without them ignore them."/>
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="260"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Lightbar" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <Grid Grid.Column="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="Lightbar" Tag="the game decides" MaxLength="7" LostFocus="Setting_Changed" TextChanged="Lightbar_TextChanged"/>
                                            <Border x:Name="LightbarSwatch" Grid.Column="1" Width="26" Height="26" CornerRadius="6" Margin="8,0,0,0" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1"/>
                                        </Grid>
                                        <TextBlock Grid.Column="2" Style="{StaticResource SideNote}" Text="#RRGGBB for a fixed colour; empty: the game sets it"/>
                                        <TextBlock Grid.Row="1" Text="Vibration" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0"/>
                                        <ComboBox x:Name="Vibration" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" SelectionChanged="Setting_Changed"/>
                                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource SideNote}" Margin="12,8,0,0" Text="USB and Bluetooth"/>
                                        <TextBlock Grid.Row="2" Text="Speaker volume" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0"/>
                                        <ComboBox x:Name="SpeakerVolume" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" SelectionChanged="Setting_Changed"/>
                                        <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource SideNote}" Margin="12,8,0,0" Text="50% as before; 100% adds 6 dB"/>
                                        <TextBlock Grid.Row="3" Text="Keyboard player" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0"/>
                                        <ComboBox x:Name="KeyboardPlayer" Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" SelectionChanged="Setting_Changed"/>
                                        <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource SideNote}" Margin="12,8,0,0" Text="gamepads fill the other players"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- System -->
                            <Border Style="{StaticResource Panel}" Padding="26,22" Margin="0,0,0,18">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7F8;" FontSize="18" Foreground="{StaticResource AccentTextBrush}"/>
                                        <TextBlock Text="System and notifications" FontSize="17" FontWeight="SemiBold" Margin="12,0,0,0"/>
                                    </StackPanel>
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="260"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Graphics card" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <ComboBox x:Name="GpuBox" Grid.Column="1" SelectionChanged="Setting_Changed" ToolTip="The graphics card the emulator renders on, as the graphics driver lists it (Vulkan). Auto lets the emulator choose; choose a card only on a PC with more than one, such as a laptop with integrated and dedicated graphics."/>
                                        <TextBlock Grid.Column="2" Style="{StaticResource SideNote}" Text="the card games render on; with one card leave Auto"/>
                                        <TextBlock Grid.Row="1" Text="Trophy toast" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0"/>
                                        <ComboBox x:Name="TrophyDuration" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" SelectionChanged="Setting_Changed"/>
                                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource SideNote}" Margin="12,8,0,0" Text="how long an unlocked trophy stays on screen"/>
                                    </Grid>
                                    <CheckBox x:Name="Trophies" Margin="0,14,0,0" Click="Setting_Changed" Content="Trophy notifications (a toast and its sound when a trophy unlocks)"/>
                                    <CheckBox x:Name="HideCursor" Click="Setting_Changed" Content="Hide the mouse cursor after 2 seconds without movement"/>
                                    <CheckBox x:Name="Network" Click="Setting_Changed" Content="Let games use this computer's local network connection"/>
                                    <TextBlock Style="{StaticResource Note}" Margin="0,8,0,0" Text="Builds that do not take an option here are started without it."/>
                                </StackPanel>
                            </Border>

                            <!-- Frame generation -->
                            <Border Style="{StaticResource Panel}" Padding="26,22" Margin="0,0,0,18">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" FontSize="18" Foreground="{StaticResource AccentTextBrush}"/>
                                        <TextBlock Text="Frame generation (DLSS)" FontSize="17" FontWeight="SemiBold" Margin="12,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Note}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,10,0,0"
                                               Text="Needs NVIDIA's Streamline runtime, which the emulator does not ship: download the Streamline SDK, unpack it and choose its folder (or its bin\x64). Only NVIDIA-signed files are used. NVIDIA RTX 40 or newer; 3x and up: RTX 50."/>
                                    <Border Background="{StaticResource InputBrush}" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,11" Margin="0,16,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="StreamlineDot" Width="7" Height="7" Margin="0,0,9,0"/>
                                            <TextBlock x:Name="StreamlineStatus" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                    <WrapPanel Margin="0,16,0,0">
                                        <Button Click="Streamline_Click" Margin="0,0,10,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="14" Margin="0,0,9,0"/>
                                                <TextBlock Text="Choose Streamline folder…"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Click="StreamlineDownload_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" FontSize="14" Margin="0,0,9,0"/>
                                                <TextBlock Text="Streamline SDK releases"/>
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Debug -->
                            <Border Style="{StaticResource Panel}" Padding="26,22" Margin="0,0,0,18">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xEBE8;" FontSize="18" Foreground="{StaticResource AccentTextBrush}"/>
                                        <TextBlock Text="Debug" FontSize="17" FontWeight="SemiBold" Margin="12,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Note}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,10,0,0"
                                               Text="For finding faults in the emulator; each makes games slower. Leave them off for playing."/>
                                    <CheckBox x:Name="VulkanValidation" Margin="0,14,0,0" Click="Setting_Changed" Content="Vulkan validation layers (needs the Vulkan SDK)"/>
                                    <CheckBox x:Name="ShaderValidation" Click="Setting_Changed" Content="Shader validation (checks every translated SPIR-V shader)"/>
                                    <CheckBox x:Name="RenderDoc" Click="Setting_Changed" Content="RenderDoc capture (with RenderDoc installed)"/>
                                </StackPanel>
                            </Border>

                            <!-- Launcher -->
                            <Border Style="{StaticResource Panel}" Padding="26,22">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE71D;" FontSize="18" Foreground="{StaticResource AccentTextBrush}"/>
                                        <TextBlock Text="Launcher" FontSize="17" FontWeight="SemiBold" Margin="12,0,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="CloseOnPlay" Margin="0,16,0,4" Click="Setting_Changed" Content="Close the launcher when a game starts"/>
                                    <TextBlock Style="{StaticResource Note}" Margin="30,0,0,0" Text="A Demon's Souls build's console window stays open with the live log; after a crash it waits for a key. Other builds write their log to the Logs page."/>
                                    <WrapPanel Margin="0,18,0,0">
                                        <Button Click="DesktopShortcut_Click" Margin="0,0,10,10">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7F8;" FontSize="14" Margin="0,0,9,0"/>
                                                <TextBlock Text="Create desktop shortcut"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Click="StartShortcut_Click" Margin="0,0,10,10">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8FC;" FontSize="14" Margin="0,0,9,0"/>
                                                <TextBlock Text="Add to Start menu"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Click="OpenRoot_Click" Margin="0,0,10,10">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="14" Margin="0,0,9,0"/>
                                                <TextBlock Text="Open launcher folder"/>
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                    <TextBlock x:Name="ShortcutNote" Style="{StaticResource Note}" Foreground="{StaticResource GoodBrush}" Visibility="Collapsed" Margin="0,0,0,0"/>
                                    <TextBlock x:Name="RootText" Style="{StaticResource Note}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ===== Logs ===== -->
                    <Grid x:Name="PageLogs" Grid.Row="1" Visibility="Collapsed" Margin="34,0,26,26">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="340"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.ColumnSpan="3" Margin="0,8,0,20">
                            <TextBlock Text="Logs" FontSize="30" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Click="LogsRefresh_Click" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13" Margin="0,0,9,0"/>
                                        <TextBlock Text="Refresh"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="LogOpen_Click" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" FontSize="13" Margin="0,0,9,0"/>
                                        <TextBlock Text="Open in Notepad"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="LogsFolder_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="13" Margin="0,0,9,0"/>
                                        <TextBlock Text="Logs folder"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="8">
                            <Grid>
                                <ListBox x:Name="LogList" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource LogItem}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="LogList_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="15" Foreground="{Binding Brush}" VerticalAlignment="Top" Margin="0,2,12,0"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Details}" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" Margin="0,3,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock x:Name="NoLogs" Text="No logs yet: they appear here after the first launch." Foreground="{StaticResource TextMutedBrush}"
                                           TextWrapping="Wrap" Margin="14" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Panel}" Background="#070C18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,0,1" Padding="16,11">
                                    <TextBlock x:Name="LogTitle" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                </Border>
                                <TextBox x:Name="LogView" Grid.Row="1" IsReadOnly="True" Height="Auto" Background="Transparent" BorderThickness="0"
                                         FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="#C5D0E3" Padding="14,10" VerticalContentAlignment="Top"
                                         TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" AcceptsReturn="True">
                                    <TextBox.Template>
                                        <ControlTemplate TargetType="TextBox">
                                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                                        </ControlTemplate>
                                    </TextBox.Template>
                                </TextBox>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ===== About ===== -->
                    <ScrollViewer x:Name="PageAbout" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="34,0,26,26">
                        <StackPanel MaxWidth="820" HorizontalAlignment="Left" Width="820">
                            <Image Source="pack://application:,,,/Assets/logo.png" Width="420" HorizontalAlignment="Left" Margin="0,24,0,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="PLAY PS5 GAMES ON PC" Foreground="{StaticResource TextSecondaryBrush}" FontSize="15" Margin="128,10,0,0">
                                <TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform>
                            </TextBlock>
                            <Border Style="{StaticResource Panel}" Padding="26,22" Margin="0,36,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="AboutVersion" FontSize="17" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource Note}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,10,0,0"
                                               Text="A launcher for KytyPS5, the open-source PlayStation 5 emulator for PC. It keeps your game library, runs each game on the KytyPS5 build you choose for it (the official release, or a community build) and gives each build only the options it supports; it downloads KytyPS5 for you and keeps every build up to date."/>
                                    <TextBlock Style="{StaticResource Note}" FontSize="12.5" Margin="0,12,0,0"
                                               Text="The launcher is free software under the GNU GPL version 2. KytyPS5 is made by the KytyPS5 developers, also under GPL-2.0; the settings and the console language list follow its official launcher (src/launcher)."/>
                                    <!-- Legal notice, as the KytyPS5 project gives it -->
                                    <Border Background="#148B5CF6" BorderBrush="#408B5CF6" BorderThickness="3,0,0,0" CornerRadius="0,8,8,0" Padding="16,12" Margin="0,16,0,0">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" FontSize="14" Foreground="#A78BFA" Margin="0,1,9,0"/>
                                                <TextBlock Text="Important" Foreground="#A78BFA" FontSize="13" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" FontSize="12.5" Margin="0,6,0,0"
                                                       Text="KytyPS5 and this launcher are not affiliated with or endorsed by Sony Interactive Entertainment or PlayStation. Neither includes games, firmware or other copyrighted system software. Play only games that you own and have obtained legally."/>
                                        </StackPanel>
                                    </Border>
                                    <WrapPanel Margin="0,20,0,0">
                                        <Button Style="{StaticResource PrimaryButton}" Click="Repo_Click" Margin="0,0,10,10">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE774;" FontSize="14" Margin="0,0,9,0"/>
                                                <TextBlock Text="GitHub: KytyPS5/KytyPS5"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Click="Releases_Click" Margin="0,0,10,10">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="14" Margin="0,0,9,0"/>
                                                <TextBlock Text="Latest KytyPS5 release"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Click="LauncherReadme_Click" Margin="0,0,10,10">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" FontSize="14" Margin="0,0,9,0"/>
                                                <TextBlock Text="README"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Click="License_Click" Margin="0,0,10,10">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" FontSize="14" Margin="0,0,9,0"/>
                                                <TextBlock Text="License"/>
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Toast -->
                    <Border x:Name="Toast" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,34" Padding="18,12"
                            Background="#16233D" BorderBrush="#2A4170" BorderThickness="1" CornerRadius="9" Opacity="0" IsHitTestVisible="False">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.5"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ToastIcon" Style="{StaticResource Icon}" Text="&#xE73E;" Foreground="{StaticResource GoodBrush}" Margin="0,0,10,0"/>
                            <TextBlock x:Name="ToastText" FontSize="13"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
